// Muslim99 database schema
// Postgres (Neon), managed with Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth required tables ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App user + data ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  bookmarks       Bookmark[]
  notes           Note[]
  readingProgress ReadingProgress?
  khatmahs        Khatmah[]
  prayerSettings  PrayerSettings?
  streak          UserStreak?
  streakDays      StreakDay[]
}

enum BookmarkType {
  AYAH
  HADITH
  TAFSIR
  DUA
  NAME
}

model Bookmark {
  id        String       @id @default(cuid())
  userId    String
  type      BookmarkType
  refId     String // e.g. "2:255" for ayah, hadith/dua/name identifier
  folder    String       @default("My Favorites")
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, refId])
  @@index([userId])
}

model Note {
  id        String       @id @default(cuid())
  userId    String
  refType   BookmarkType
  refId     String
  content   String       @db.Text
  tags      String[]     @default([])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, refType, refId])
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String   @unique
  surah     Int      @default(1)
  ayah      Int      @default(1)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Khatmah {
  id          String    @id @default(cuid())
  userId      String
  startDate   DateTime  @default(now())
  targetDays  Int
  pagesRead   Int       @default(0)
  status      String    @default("active") // active | completed | abandoned
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PrayerSettings {
  id            String  @id @default(cuid())
  userId        String  @unique
  method        Int     @default(2) // Aladhan calculation method id
  asrMadhhab    String  @default("shafii") // "hanafi" | "shafii"
  format24h     Boolean @default(false)
  adjustments   Json    @default("{}")
  notifyFajr    Boolean @default(true)
  notifyDhuhr   Boolean @default(true)
  notifyAsr     Boolean @default(true)
  notifyMaghrib Boolean @default(true)
  notifyIsha    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Traffic analytics (first-party, no IPs or personal data stored) ---

model PageView {
  id         String   @id @default(cuid())
  visitorId  String // random id kept in the visitor's browser
  sessionId  String // random id per browser tab session
  path       String
  section    String // first path segment: "quran", "hadith", "tafsir", ...
  referrer   String? // referring host, external only
  country    String? // ISO code from the hosting edge (Vercel)
  city       String?
  device     String // mobile | tablet | desktop
  browser    String
  os         String
  userId     String? // set when the visitor is signed in
  durationMs Int? // time the page was actually visible, updated by heartbeats and on leave
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
}

// One row per visitor, refreshed by a heartbeat while a page is open —
// "online now" is every row seen in the last couple of minutes.
model ActiveVisitor {
  visitorId String   @id
  path      String
  country   String?
  device    String
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
}

// Messages sent through the Contact page (admin inbox at /admin/messages)
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  emailed   Boolean  @default(false) // delivered to the team mailbox
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// --- Blog (written in the admin panel at /admin/blog) ---

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  excerpt         String     @db.Text
  content         String     @db.Text // Markdown
  coverImage      String? // URL — an uploaded BlogImage (/api/blog-image/<id>) or an external https URL
  coverAlt        String?
  category        String     @default("General")
  tags            String[]   @default([])
  status          BlogStatus @default(DRAFT)
  featured        Boolean    @default(false)
  authorName      String
  metaTitle       String?
  metaDescription String?
  views           Int        @default(0)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

// Images uploaded from the blog editor, stored in the database (the site's
// serverless hosting has no persistent disk). Served by /api/blog-image/<id>.
model BlogImage {
  id        String   @id @default(cuid())
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

// Sign-ups waiting for their email code. The account (User) is created only
// after the code is verified; rows expire and are replaced on a new request.
model PendingSignup {
  email        String   @id
  name         String?
  passwordHash String
  codeHash     String // sha256 of the code — the code itself is never stored
  expiresAt    DateTime
  attempts     Int      @default(0)
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())
}

// "Forgot password" codes. One row per email; only the code's hash is stored.
model PasswordReset {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
}

// --- Daily streak (signed-in users) ---
// Dates are calendar days ("YYYY-MM-DD") in the user's own time zone.
model UserStreak {
  userId         String   @id
  current        Int      @default(0)
  longest        Int      @default(0)
  lastDate       String? // last day the user opened the site
  restoreCredits Int      @default(5) // refilled to 5 every month
  creditsMonth   String? // "YYYY-MM" the credits belong to
  brokenStreak   Int      @default(0) // streak lost on brokenOn, restorable that day
  brokenOn       String?
  missedDays     Int      @default(0) // days missed — the restore costs this many credits
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StreakDay {
  userId   String
  date     String
  restored Boolean @default(false) // a missed day filled in with a restore credit

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}
